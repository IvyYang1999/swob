{
  "name": "claude-session-manager",
  "version": "1.2.0",
  "description": "Visual session manager for Claude Code",
  "license": "AGPL-3.0-only",
  "author": "IvyYang1999",
  "main": "./out/main/index.js",
  "bin": {
    "swob": "./out/main/cli.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win nsis --x64 --publish never --config.npmRebuild=false",
    "deploy": "bash scripts/deploy-local.sh",
    "dmg": "bash scripts/build-dmg-desktop.sh",
    "check:conflicts": "node scripts/check-conflict-markers.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "npm run check:conflicts && npm run typecheck",
    "docs:gen": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "test": "npm run check && vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx electron-vite build && npx playwright test",
    "test:e2e:windows-native": "playwright test e2e/windows-native-packaged.spec.ts",
    "test:cli:packaged": "node scripts/run-cli-packaged-contract.mjs",
    "test:all": "vitest run && npx electron-vite build && npx playwright test"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-virtual": "^3.14.7",
    "better-sqlite3": "^13.0.1",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^40.10.6",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "undici": "7.28.0"
  }
}
