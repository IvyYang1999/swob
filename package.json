{
  "name": "claude-session-manager",
  "version": "1.3.1",
  "description": "Visual session manager for Claude Code",
  "license": "Apache-2.0",
  "author": "IvyYang1999",
  "main": "./out/main/index.js",
  "bin": {
    "swob": "./out/main/cli.js",
    "swob-workflow": "./scripts/workflow/swob-workflow.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir && npm run check:package",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:verify": "npm run build && electron-builder --mac dmg zip --arm64 --publish never --config.mac.identity=null --config.mac.notarize=false && npm run check:package",
    "build:win": "npm run build && electron-builder --win nsis --x64 --publish never --config.npmRebuild=false && npm run check:package",
    "deploy": "bash scripts/deploy-local.sh",
    "dmg": "bash scripts/build-dmg-desktop.sh",
    "check:conflicts": "node scripts/check-conflict-markers.mjs",
    "schema:gen": "node scripts/generate-provider-schema.mjs",
    "schema:check": "node scripts/generate-provider-schema.mjs --check",
    "source-matrix:generate": "node scripts/generate-source-matrix.mjs",
    "check:recovery-readonly": "node scripts/recovery/check-readonly.mjs",
    "check:library-writes": "node scripts/check-library-write-boundary.mjs",
    "check:i18n": "node scripts/check-i18n-literals.mjs",
    "check:pricing": "node scripts/check-price-snapshots.mjs && node scripts/check-price-candidates.mjs",
    "pricing:candidate": "node scripts/pricing/update-catalog-candidate.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "check:asset-evidence": "node scripts/compliance/t131-inventory.mjs --repo . --check-assets",
    "notices:generate": "node scripts/generate-third-party-notices.mjs",
    "notices:check": "node scripts/generate-third-party-notices.mjs --check",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:package-policy": "node scripts/check-package.selftest.mjs",
    "test:dco": "node scripts/check-dco.mjs --self-test",
    "workflow:validate": "node scripts/workflow/swob-workflow.mjs validate",
    "workflow:selftest": "node scripts/workflow/workflow.selftest.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "npm run check:conflicts && npm run schema:check && npm run check:recovery-readonly && npm run check:library-writes && npm run check:i18n && npm run check:pricing && npm run icons:check && npm run check:asset-evidence && npm run notices:check && npm run test:package-policy && npm run test:dco && npm run typecheck",
    "recovery:inventory": "node scripts/recovery/inventory.mjs",
    "docs:export": "node scripts/generate-docs.mjs",
    "test": "npm run check && vitest run",
    "test:watch": "vitest",
    "test:library-isolation": "vitest run src/main/e2e-library-isolation.test.ts src/main/runtime-isolation-bootstrap.test.ts --maxWorkers=1",
    "test:e2e": "npx electron-vite build && npx playwright test",
    "test:e2e:windows-native": "playwright test e2e/windows-native-packaged.spec.ts",
    "test:cli:packaged": "node scripts/run-cli-packaged-contract.mjs",
    "test:all": "vitest run && npx electron-vite build && npx playwright test"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-virtual": "^3.14.7",
    "ajv": "^8.17.1",
    "better-sqlite3": "^13.0.1",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.11"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron/asar": "3.4.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^40.10.6",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.0.1",
    "js-yaml": "4.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "undici": "7.28.0"
  }
}
